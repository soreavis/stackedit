{
  "name": "stackedit",
  "version": "5.16.1",
  "description": "Free, open-source, full-featured Markdown editor",
  "author": "Benoit Schweblin",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/benweet/stackedit/issues"
  },
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/build-prism.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint 'src/**/*.{js,vue}' 'dev-server/**/*.js' 'test/unit/**/*.js'",
    "typecheck": "vue-tsc --noEmit",
    "size": "size-limit",
    "unit": "NODE_NO_WARNINGS=1 vitest run",
    "unit-with-coverage": "NODE_NO_WARNINGS=1 vitest run --coverage",
    "test": "NODE_NO_WARNINGS=1 vitest run",
    "preversion": "npm run test",
    "postversion": "git push origin main --tags && npm publish",
    "patch": "npm version patch -m \"Tag v%s\"",
    "minor": "npm version minor -m \"Tag v%s\"",
    "major": "npm version major -m \"Tag v%s\"",
    "oxlint": "oxlint src api",
    "test:browser": "vitest run --config vitest.browser.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "abcjs": "^6.6.3",
    "bezier-easing": "^3.0.0",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.8",
    "file-saver": "^2.0.5",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.2.0",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-pandoc-renderer": "1.2.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "mermaid": "^11.15.0",
    "mitt": "^3.0.1",
    "modern-normalize": "^3.0.1",
    "pinia": "^3.0.4",
    "prismjs": "^1.30.0",
    "tinykeys": "^4.0.0",
    "turndown": "^7.2.4",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-app": "^12.1.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/compiler-sfc": "^3.5.35",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.68.0",
    "playwright": "^1.60.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.100.0",
    "size-limit": "^12.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.3",
    "workbox-window": "^7.4.0"
  },
  "size-limit": [
    {
      "name": "main bundle",
      "path": "dist/static/index-*.js",
      "limit": "200 KB"
    },
    {
      "name": "mermaid (lazy-loaded)",
      "path": "dist/static/mermaid-*.js",
      "limit": "800 KB"
    },
    {
      "name": "prism",
      "path": "dist/static/prismjs-*.js",
      "limit": "230 KB"
    },
    {
      "name": "abcjs",
      "path": "dist/static/abcjs-*.js",
      "limit": "175 KB"
    },
    {
      "name": "katex",
      "path": "dist/static/katex-*.js",
      "limit": "90 KB"
    },
    {
      "name": "markdown-it",
      "path": "dist/static/markdown-it-*.js",
      "limit": "80 KB"
    },
    {
      "name": "vue runtime",
      "path": "dist/static/vue-*.js",
      "limit": "40 KB"
    }
  ],
  "engines": {
    "node": "22.x",
    "npm": ">= 9.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ]
}
